PORT=3000
TRUST_PROXY_HOPS=0
FIREBASE_PROJECT_ID=replace_with_your_firebase_project_id
# Use Application Default Credentials locally, or a secret environment variable on the host.
FIREBASE_SERVICE_ACCOUNT_JSON=
PUBLIC_BASE_URL=http://localhost:3000
PHONE_LOOKUP_HMAC_SECRET=replace_with_at_least_32_random_bytes
PUBLIC_FIREBASE_API_KEY=replace_with_public_firebase_web_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
PUBLIC_FIREBASE_APP_ID=replace_with_public_firebase_web_app_id
GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=replace_with_your_openai_key
