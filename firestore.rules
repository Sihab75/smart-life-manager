rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoUrl', 'lastLoginAt', 'fcmToken', 'phoneNumber'
        ])
        && request.resource.data.uid == userId
        && (!('phoneNumber' in request.resource.data)
          || request.resource.data.phoneNumber == request.auth.token.get('phone_number', null));
      allow delete: if false;
    }

    match /locationRequests/{requestId} {
      allow read, write: if false;
    }

    match /locationShares/{shareId} {
      allow read, write: if false;
    }

    match /locationRequestLocks/{lockId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
